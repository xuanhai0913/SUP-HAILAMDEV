# SUP-HAILAMDEV .gitignore

# Build artifacts
/bin/
/build/
/dist/
*.exe
*.exe~
*.dll
*.so
*.dylib

# Tests and coverage
*.test
coverage.out
coverage.html

# SUP runtime output
/reports/
/cache/
/logs/

# Local configuration and secrets
.env
.env.*
!.env.example
/config/production.yaml
/config/*.local.yaml

# Local tooling
.idea/
.vscode/
*.swp
*.swo
.DS_Store

# Certificates
certs/
*.pem
*.key
*.crt

# Temporary
tmp/
temp/
*.tmp

# Dependencies
vendor/

# Coverage
coverage.out
coverage.html

# Profiles
*.prof
*.pprof

# Cache
cache/
*.cache

# Reports
reports/
*.sarif
*.html
*.pdf

# Signatures (compiled)
signatures/*.compiled