# CLI Dockerfile
FROM golang:1.21-alpine AS builder

RUN apk add --no-cache git make libyara-dev gcc musl-dev

WORKDIR /app

COPY go.mod go.sum ./
RUN go mod download

COPY . .

RUN make build

FROM alpine:3.18

RUN apk add --no-cache libyara docker-cli ca-certificates

WORKDIR /app

COPY --from=builder /app/bin/sup .
COPY --from=builder /app/signatures ./signatures
COPY --from=builder /app/config ./config

ENTRYPOINT ["./sup"]